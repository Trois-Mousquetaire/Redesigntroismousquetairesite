# Discord webhooks for the release + AI-testing pipeline.
# Copy to .env and fill in. .env is GITIGNORED in this repo because the repo
# is PUBLIC - never commit the real URLs (the committed-.env convention from
# other projects applies to private repos only).
#
# Both channels must be Discord FORUM channels (webhooks open one thread per
# release / per testing round; a plain text channel returns 400 on thread_name).
DISCORD_RELEASE_WEBHOOK=
DISCORD_TESTING_WEBHOOK=
